# Copia este archivo a ".env" y completa los valores reales.
# NUNCA subas ".env" a git.

# ===== JWT =====
SECURITY_JWT_SECRET=CAMBIAR_ESTE_VALOR_POR_UN_SECRET_LARGO
SECURITY_JWT_ISSUER=pv-challenge
SECURITY_JWT_EXPIRYSECONDS=3600

# ===== Redis =====
# En Docker, el servicio se llama "redis", por eso el host es redis
REDIS_URL=redis://redis:6379

# ===== Mongo =====
SPRING_DATA_MONGODB_URI=mongodb://mongo:27017/pvdb

# ===== Spring =====
SPRING_PROFILES_ACTIVE=redis